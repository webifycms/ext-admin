includes:
	- vendor/webifycms/dev-tools/phpstan-default.neon
	- vendor/phpat/phpat/extension.neon

parameters:
	level: 10
	paths:
		- src
		- test
	excludePaths:
		- vendor
	reportUnmatchedIgnoredErrors: false

services:
	-
		class: Webify\Admin\Test\Architecture\ArchitectureSpec
		tags:
			- phpat.test