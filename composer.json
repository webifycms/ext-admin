{
  "name": "webifycms/ext-admin",
  "description": "The WebifyCMS admin extension handles administration of the entire application.",
  "type": "webifycms-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohammed Shifreen",
      "email": "mshifreen@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "webifycms/ext-base": "^0.1.0-alpha"
  },
  "require-dev": {
    "webifycms/dev-tools": "^1.2",
    "phpunit/phpunit": "^13.1",
    "fakerphp/faker": "^1.24",
    "phpat/phpat": "^0.12",
    "filp/whoops": "^2.18",
    "middlewares/whoops": "^2.1",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Webify\\Admin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webify\\Admin\\Test\\": "test/"
    }
  },
  "optimize-autoloader": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "scripts": {
    "analyse": [
      "phpstan"
    ],
    "sniff": [
      "php-cs-fixer fix --show-progress=dots --diff --dry-run"
    ],
    "test": [
      "phpunit test"
    ],
    "code-check": ["@analyse", "@sniff"],
    "code-format": [
      "php-cs-fixer fix --show-progress=dots"
    ]
  }
}